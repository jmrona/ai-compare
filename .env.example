# ai-compare · local configuration
# Optional: `docker compose up` works without it. Copy this file to .env at the repo root to add
# API keys or change ports. The backend, frontend and infra all read that single .env.
# .env is git-ignored: never commit your keys.

# ── Ports ──────────────────────────────────────────────────
# UI, Connect API and terminal WebSockets. Published on 127.0.0.1 only.
APP_PORT=4700
# Inference proxy. Reachable only from the internal Docker network.
PROXY_PORT=4701
# Vite dev server (pnpm dev).
FRONTEND_DEV_PORT=5173

# ── Docker ─────────────────────────────────────────────────
# Path of the Docker socket on the host. The default works with Docker Desktop (macOS,
# Windows, Linux), OrbStack and native Linux. Colima: ~/.colima/default/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=aicompare
POSTGRES_PASSWORD=aicompare
POSTGRES_DB=aicompare
# Published on 127.0.0.1 for development outside Docker (uncommon port to avoid clashes).
POSTGRES_PORT=55432
# URL used by the backend when it runs on the host (go run). Inside Docker, compose points it at the "postgres" host.
DATABASE_URL=postgres://aicompare:aicompare@localhost:55432/aicompare?sslmode=disable

# ── Providers ──────────────────────────────────────────────
# Phase 1: OpenAI only. Keys never enter the agent containers.
OPENAI_API_KEY=
# Phase 2.
ANTHROPIC_API_KEY=
# Phase 2: local OpenAI-compatible server (Ollama, LM Studio…).
LOCAL_MODELS_BASE_URL=http://host.docker.internal:11434/v1

# ── Model and price catalogue ──────────────────────────────
MODELS_DEV_URL=https://models.dev/api.json
# models.dev providers kept from the catalogue (it publishes all of them in one file).
CATALOG_PROVIDERS=openai,anthropic

# ── Frontend (only VITE_* variables reach the browser) ─────
# API base as seen from the browser.
VITE_API_BASE_URL=/api
